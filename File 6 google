-- Helper functions
CREATE OR REPLACE FUNCTION auth.user_role() RETURNS user_role AS $$
  SELECT role FROM public.profiles WHERE id = auth.uid();
$$ LANGUAGE sql STABLE;

CREATE OR REPLACE FUNCTION auth.user_company_id() RETURNS UUID AS $$
  SELECT company_id FROM public.profiles WHERE id = auth.uid();
$$ LANGUAGE sql STABLE;

CREATE OR REPLACE FUNCTION auth.is_founder() RETURNS BOOLEAN AS $$
  SELECT role = 'founder' FROM public.profiles WHERE id = auth.uid();
$$ LANGUAGE sql STABLE;

CREATE OR REPLACE FUNCTION auth.is_executive() RETURNS BOOLEAN AS $$
  SELECT role IN ('chairman','vice_chairman','president','vice_president','ceo','managing_director','executive')
  FROM public.profiles WHERE id = auth.uid();
$$ LANGUAGE sql STABLE;

CREATE OR REPLACE FUNCTION auth.is_manager() RETURNS BOOLEAN AS $$
  SELECT role IN ('manager','team_leader','supervisor','hr')
  FROM public.profiles WHERE id = auth.uid();
$$ LANGUAGE sql STABLE;

