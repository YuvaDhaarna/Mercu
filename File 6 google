-- PROFILES
CREATE POLICY "Users read own profile" ON profiles FOR SELECT USING (auth.uid() = id);
CREATE POLICY "Founders read all company profiles" ON profiles FOR SELECT USING (auth.is_founder() = true AND company_id = auth.user_company_id());
CREATE POLICY "Managers read team profiles" ON profiles FOR SELECT USING (auth.is_manager() = true AND department_id = (SELECT department_id FROM profiles WHERE id = auth.uid()));
CREATE POLICY "Users update own profile" ON profiles FOR UPDATE USING (auth.uid() = id) WITH CHECK (auth.uid() = id);

-- COMPANIES
CREATE POLICY "Users read own company" ON companies FOR SELECT USING (id = auth.user_company_id() OR auth.is_founder() = true);
CREATE POLICY "Only founder manages company" ON companies FOR ALL USING (auth.is_founder() = true);

-- OFFICE ROOMS
CREATE POLICY "Read accessible rooms" ON office_rooms FOR SELECT USING (
  auth.is_founder() = true OR auth.is_executive() = true OR
  EXISTS (SELECT 1 FROM room_memberships WHERE room_id = id AND user_id = auth.uid())
);
CREATE POLICY "Create rooms" ON office_rooms FOR INSERT WITH CHECK (auth.is_founder() = true OR auth.is_executive() = true);
CREATE POLICY "Manage rooms" ON office_rooms FOR ALL USING (auth.is_founder() = true OR created_by = auth.uid());

-- TASKS
CREATE POLICY "Read tasks" ON tasks FOR SELECT USING (
  EXISTS (SELECT 1 FROM room_memberships WHERE room_id = tasks.room_id AND user_id = auth.uid())
  OR auth.is_founder() = true OR auth.is_executive() = true
);
CREATE POLICY "Create tasks" ON tasks FOR INSERT WITH CHECK (
  EXISTS (SELECT 1 FROM room_memberships WHERE room_id = tasks.room_id AND user_id = auth.uid())
  OR auth.is_founder() = true
);
CREATE POLICY "Update tasks" ON tasks FOR UPDATE USING (
  auth.is_founder() = true OR assigned_to = auth.uid() OR
  (auth.is_manager() = true AND EXISTS (SELECT 1 FROM room_memberships WHERE room_id = tasks.room_id AND user_id = auth.uid()))
);

-- CHAT MESSAGES
CREATE POLICY "Read messages in accessible rooms" ON chat_messages FOR SELECT USING (
  EXISTS (SELECT 1 FROM room_memberships WHERE room_id = chat_messages.room_id AND user_id = auth.uid())
  OR auth.is_founder() = true OR auth.is_executive() = true
);
CREATE POLICY "Insert messages in rooms you're in" ON chat_messages FOR INSERT WITH CHECK (
  EXISTS (SELECT 1 FROM room_memberships WHERE room_id = chat_messages.room_id AND user_id = auth.uid())
  OR auth.is_founder() = true
);
CREATE POLICY "Update own messages" ON chat_messages FOR UPDATE USING (user_id = auth.uid()) WITH CHECK (user_id = auth.uid());

-- HEALTH METRICS
CREATE POLICY "Users manage own health metrics" ON health_metrics FOR ALL USING (user_id = auth.uid());
CREATE POLICY "Managers read team health metrics" ON health_metrics FOR SELECT USING (
  auth.is_manager() = true AND EXISTS (
    SELECT 1 FROM profiles WHERE id = health_metrics.user_id AND department_id = (SELECT department_id FROM profiles WHERE id = auth.uid())
  )
);
CREATE POLICY "Founder read all health metrics" ON health_metrics FOR SELECT USING (auth.is_founder() = true);

-- INVITE TOKENS
CREATE POLICY "Founder manages invites" ON invite_tokens FOR ALL USING (auth.is_founder() = true);
CREATE POLICY "Anyone read valid invite" ON invite_tokens FOR SELECT USING (expires_at > NOW() AND used_at IS NULL);

-- OAUTH TOKENS
CREATE POLICY "Users manage own tokens" ON google_tokens FOR ALL USING (user_id = auth.uid());
CREATE POLICY "Users manage own tokens" ON canva_tokens FOR ALL USING (user_id = auth.uid());
CREATE POLICY "Users manage own tokens" ON zoom_tokens FOR ALL USING (user_id = auth.uid());
CREATE POLICY "Users manage own tokens" ON slack_tokens FOR ALL USING (user_id = auth.uid());

