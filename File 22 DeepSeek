import axios from 'axios';

export async function askDeepSeek(prompt: string, options?: { systemPrompt?: string; context?: any }) {
  try {
    const response = await axios.post('https://api.deepseek.com/chat/completions', {
      model: 'deepseek-chat',
      messages: [...(options?.systemPrompt ? [{ role: 'system', content: options.systemPrompt }] : []), ...(options?.context ? [{ role: 'user', content: `Context: ${JSON.stringify(options.context)}` }] : []), { role: 'user', content: prompt }],
      temperature: 0.7, max_tokens: 4096,
    }, { headers: { Authorization: `Bearer ${process.env.DEEPSEEK_API_KEY}`, 'Content-Type': 'application/json' } });
    return response.data.choices[0].message.content;
  } catch { return 'DeepSeek service unavailable. Please try again later.'; }
}
