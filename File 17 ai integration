import { NextRequest, NextResponse } from 'next/server';
import { createServer } from '@/lib/supabase/server';
import { askChatGPT } from '@/lib/ai/chatgpt';
import { askGemini } from '@/lib/ai/gemini';
import { askPerplexity } from '@/lib/ai/perplexity';
import { askClaude } from '@/lib/ai/claude';
import { askDeepSeek } from '@/lib/ai/deepseek';

export async function POST(req: NextRequest) {
  try {
    const { prompt, provider, context } = await req.json();
    const supabase = createServer();
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) return NextResponse.json({ error: 'Unauthorized' }, { status: 401 });

    const { data: profile } = await supabase.from('profiles').select('role').eq('id', user.id).single();
    if (!profile) return NextResponse.json({ error: 'Profile not found' }, { status: 404 });

    const rolePrompts: Record<string, string> = {
      founder: 'You are a strategic business advisor. Provide high-level insights, identify risks, and recommend actions.',
      ceo: 'You are an operational partner. Focus on execution, team performance, and strategic alignment.',
      cfo: 'You are a financial intelligence advisor. Focus on financial data, forecasting, and risk management.',
      manager: 'You are a team coach. Provide practical guidance, team optimization tips, and coaching advice.',
      employee: 'You are a personal guide. Focus on daily productivity, learning, and career growth.',
    };

    const systemPrompt = rolePrompts[profile.role] || rolePrompts.employee;
    let result = '';
    let modelUsed = '';
    const providerToUse = provider || 'gemini';

    const contextData = { role: profile.role, userId: user.id, ...context };

    switch (providerToUse) {
      case 'chatgpt': result = await askChatGPT(prompt, { systemPrompt, context: contextData }); modelUsed = 'ChatGPT'; break;
      case 'perplexity': result = await askPerplexity(prompt, { systemPrompt, context: contextData }); modelUsed = 'Perplexity'; break;
      case 'claude': result = await askClaude(prompt, { systemPrompt, context: contextData }); modelUsed = 'Claude'; break;
      case 'deepseek': result = await askDeepSeek(prompt, { systemPrompt, context: contextData }); modelUsed = 'DeepSeek'; break;
      default: result = await askGemini(prompt, { systemPrompt, context: contextData }); modelUsed = 'Gemini'; break;
    }

    await supabase.from('audit_logs').insert({
      user_id: user.id, action: 'ai_query', target_type: 'mercury_ai',
      metadata: { prompt: prompt.substring(0, 100), provider: providerToUse, model: modelUsed, role: profile.role }
    });

    return NextResponse.json({ result, model: modelUsed, provider: providerToUse, role: profile.role });

  } catch (error: any) {
    console.error('Mercury AI error:', error);
    return NextResponse.json({ error: error.message || 'Failed to process request' }, { status: 500 });
  }
}
